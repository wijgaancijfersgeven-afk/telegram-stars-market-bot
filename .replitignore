# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Do not include local environment configuration in deployment bundles.
.env
.env.*
!.env.example

# Runtime data must live on persistent storage, not in the deployment bundle.
**/*.sqlite
**/*.sqlite-shm
**/*.sqlite-wal
